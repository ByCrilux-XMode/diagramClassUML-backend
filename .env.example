PORT=3000
# Conexión completa (opcional; si está definida, reemplaza a DB_*)
# DATABASE_URL=postgresql://usuario:password@host:5432/base?sslmode=require&channel_binding=require
# Modo descompuesto:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=examen_sw1
# Activar solo si la base requiere TLS (p.ej. Neon: true)
DB_SSL=false
JWT_SECRET=clave-secreta-local-de-examen
JWT_EXPIRES_IN=1d
# Producción: true (cookie Secure; SameSite=None cuando es cross-site).
# Con el proxy same-origin de Next la cookie es first-party del frontend.
COOKIE_SECURE=false
# Solo si frontend y API comparten un dominio registrable propio
# (p. ej. app.x.com + api.x.com). NUNCA `.vercel.app`: es public suffix y el
# navegador rechaza esa cookie. Con el proxy `/backend` debe quedar vacío.
# COOKIE_DOMAIN=.midominio.com
CORS_ORIGIN=http://localhost:5173

# Límite de turnos de IA por usuario y proyecto cada minuto. 0 desactiva.
IA_LIMITE_TURNOS_MINUTO=10

# Operación de MongoDB (sin TTL): capacidad del clúster y umbral de alerta.
MONGO_CAPACIDAD_MB=512
MONGO_UMBRAL_MB=70
# MONGO_EXPORT_DIR=export

# MongoDB Atlas — bitácora, chat, propuestas, planes y turnos de IA
# La base se crea sola al insertar el primer documento.
MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=diagramador

# Firebase Admin (backend). NO es el google-services.json de Flutter.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Si estas variables no están definidas, la app arranca pero omite el envío de push.
# FIREBASE_PROJECT_ID=mi-proyecto-firebase
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mi-proyecto-firebase.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
# Alternativa: ruta al JSON de la cuenta de servicio.
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\service-account.json
